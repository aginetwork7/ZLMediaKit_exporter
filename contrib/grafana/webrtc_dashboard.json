    {
      "type": "row",
      "title": "whip_batch 实时状态",
      "id": 11,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "whip_batch 会话",
      "description": "",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (nvr_id, state, transport_id) (zlm_whip_batch_info{nvr_id=~\"$nvr_id\"})",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (nvr_id) (zlm_whip_batch_slots{nvr_id=~\"$nvr_id\"})",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (nvr_id) (zlm_whip_batch_bound_slots{nvr_id=~\"$nvr_id\"})",
          "refId": "C",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (nvr_id) (zlm_whip_batch_receiving_slots{nvr_id=~\"$nvr_id\"})",
          "refId": "D",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (nvr_id) (zlm_whip_batch_viewers{nvr_id=~\"$nvr_id\"})",
          "refId": "E",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (nvr_id) (label_replace(zlm_webrtc_publisher_duration_seconds{session_type=\"whip_batch_publisher\",stream=~\"$nvr_id\"}, \"nvr_id\", \"$1\", \"stream\", \"(.*)\"))",
          "refId": "F",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (nvr_id) (rate(zlm_whip_batch_received_bytes_total{nvr_id=~\"$nvr_id\"}[$__rate_interval]))",
          "refId": "G",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "nvr_id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "Value #A": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true
            },
            "indexByName": {
              "nvr_id": 0,
              "app": 1,
              "state": 2,
              "transport_id": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6,
              "Value #E": 7,
              "Value #F": 8,
              "Value #G": 9
            },
            "renameByName": {
              "nvr_id": "NVR",
              "state": "状态",
              "transport_id": "连接 ID",
              "Value #B": "槽位",
              "Value #C": "已绑定",
              "Value #D": "收流中",
              "Value #E": "观看人数",
              "Value #F": "在线时长",
              "Value #G": "入站速率"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "在线时长"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "入站速率"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
    {
      "type": "table",
      "title": "whip_batch source（含观看人数）",
      "description": "",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (nvr_id, mac, source_id, slot_id, play_stream) (zlm_whip_batch_source_info{nvr_id=~\"$nvr_id\",mac=~\"$mac\"})",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (source_id) (zlm_whip_batch_source_online{nvr_id=~\"$nvr_id\"})",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (source_id) (zlm_whip_batch_source_receiving{nvr_id=~\"$nvr_id\"})",
          "refId": "C",
          "range": false,
